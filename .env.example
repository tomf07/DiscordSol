# Discord
DISCORD_TOKEN=                    # Bot token from Discord Developer Portal
DISCORD_CHANNEL_ID=               # Channel ID(s) to monitor, comma-separated

# Solana Wallet
WALLET_PRIVATE_KEY=               # Base58 encoded private key

# RPC
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Buy Settings
BUY_AMOUNT_SOL=0.1                # SOL to spend per CA detected
SLIPPAGE_BPS=300                  # Slippage in basis points (300 = 3%)
MAX_SPEND_SOL_PER_HOUR=1.0        # Max total SOL spend per hour

# Safety
DRY_RUN=true                      # Log intent but don't send transactions
AUTO_CONFIRM=false                 # If false, bot sends confirm button before buying

# Logging
LOG_LEVEL=info                    # debug | info | warn | error
